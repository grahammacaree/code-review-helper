# User API key from https://cursor.com/dashboard/api
# The SDK does not read this file; the server loads it via dotenv.
CURSOR_API_KEY=cursor_...

# Optional. Default composer-2.5
# CURSOR_MODEL=composer-2.5

# Optional. Default 8787
# PORT=8787

# TypeSafe System One (Jev) — typed judgments for routing / grading / ranking.
# https://docs.typesafe.ai — dashboard key; server-side only.
# TYPESAFE_API_KEY=
# Optional overrides (SDK defaults: api.typesafe.ai, jev-latest)
# TYPESAFE_BASE_URL=
# TYPESAFE_DEFAULT_MODEL=
